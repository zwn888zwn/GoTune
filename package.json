{
  "name": "gotune",
  "displayName": "GoTune",
  "description": "Source-centered Go performance analysis for VS Code.",
  "version": "0.6.0",
  "publisher": "gotune",
  "repository": {
    "type": "git",
    "url": "https://github.com/zwn888zwn/GoTune.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "activationEvents": [
    "onLanguage:go",
    "onView:gotune.running",
    "onView:gotune.liveView",
    "onView:gotune.sessions",
    "onView:gotune.profileView"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "test": "npm run compile && node --test test/*.test.js",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/vscode": "^1.100.0",
    "typescript": "^7.0.2"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gotune",
          "title": "Go 性能",
          "icon": "resources/performance.svg"
        }
      ],
      "panel": [
        {
          "id": "gotuneOptimization",
          "title": "Go Optimization",
          "icon": "resources/performance.svg"
        }
      ]
    },
    "views": {
      "gotune": [
        {
          "id": "gotune.running",
          "name": "性能分析"
        },
        {
          "type": "webview",
          "id": "gotune.liveView",
          "name": "Live 运行趋势",
          "visibility": "collapsed"
        },
        {
          "id": "gotune.sessions",
          "name": "Profile 快照"
        }
      ],
      "gotuneOptimization": [
        {
          "type": "webview",
          "id": "gotune.profileView",
          "name": "Profile"
        }
      ]
    },
    "commands": [
      {
        "command": "gotune.importProfile",
        "title": "GoTune: 导入 pprof 文件",
        "icon": "$(folder-opened)"
      },
      {
        "command": "gotune.runWithProfiler",
        "title": "GoTune: 启动并连接性能分析",
        "icon": "$(run)"
      },
      {
        "command": "gotune.analyzeCurrentFunction",
        "title": "GoTune: 采集并分析当前函数",
        "icon": "$(symbol-method)"
      },
      {
        "command": "gotune.stopProfilerTarget",
        "title": "GoTune: 停止分析目标",
        "icon": "$(debug-stop)"
      },
      {
        "command": "gotune.captureCpu",
        "title": "GoTune: 开始/停止 CPU 录制",
        "icon": "$(record)"
      },
      {
        "command": "gotune.captureHeap",
        "title": "GoTune: 采集当前存活内存"
      },
      {
        "command": "gotune.showTargetOutput",
        "title": "GoTune: 查看目标输出",
        "icon": "$(output)"
      },
      {
        "command": "gotune.fetchProfile",
        "title": "GoTune: 从 pprof 地址采集",
        "icon": "$(cloud-download)"
      },
      {
        "command": "gotune.showProfile",
        "title": "GoTune: 查看当前性能证据"
      },
      {
        "command": "gotune.showCurrentFunctionInProfile",
        "title": "GoTune: 在当前 Profile 中定位"
      },
      {
        "command": "gotune.setBaseline",
        "title": "GoTune: 设为基线"
      },
      {
        "command": "gotune.compareWithBaseline",
        "title": "GoTune: 与基线比较",
        "icon": "$(git-compare)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "gotune.runWithProfiler",
          "when": "view == gotune.running && !gotune.targetActive",
          "group": "navigation@1"
        },
        {
          "command": "gotune.stopProfilerTarget",
          "when": "view == gotune.running && gotune.targetActive",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "gotune.setBaseline",
          "when": "view == gotune.running && viewItem == gotuneSession",
          "group": "gotune@1"
        },
        {
          "command": "gotune.compareWithBaseline",
          "when": "view == gotune.running && viewItem == gotuneSession && gotune.hasBaseline",
          "group": "gotune@2"
        }
      ],
      "editor/context": [
        {
          "command": "gotune.analyzeCurrentFunction",
          "when": "editorLangId == go",
          "group": "navigation@90"
        },
        {
          "command": "gotune.showCurrentFunctionInProfile",
          "when": "editorLangId == go && gotune.hasActiveProfile",
          "group": "navigation@100"
        }
      ],
      "editor/title": [
        {
          "command": "gotune.runWithProfiler",
          "when": "editorLangId == go && !gotune.targetActive",
          "group": "navigation@20"
        },
        {
          "command": "gotune.stopProfilerTarget",
          "when": "editorLangId == go && gotune.targetActive",
          "group": "navigation@20"
        }
      ]
    },
    "configuration": {
      "title": "GoTune",
      "properties": {
        "gotune.goExecutable": {
          "type": "string",
          "default": "go",
          "description": "GoTune 使用的 Go 可执行文件；保持 go 时优先复用 VS Code Go 配置。"
        },
        "gotune.fetchTimeoutSeconds": {
          "type": "number",
          "default": 45,
          "minimum": 1,
          "description": "下载 pprof Profile 的超时时间。"
        },
        "gotune.captureCpuSeconds": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 300,
          "description": "自动分析、累计分配和性能场景的默认采集时长；手动 CPU 录制使用开始/停止按钮。"
        },
        "gotune.runBuildFlags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "启动当前 Go main 时追加的构建参数。"
        },
        "gotune.runArguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "传给 Go 程序的运行参数。"
        },
        "gotune.runEnvironment": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "description": "启动 Go 程序时追加的环境变量。"
        },
        "gotune.sourcePathMappings": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "description": "把远程或容器中的源码路径映射到本地工作区，例如 /app/src -> /Users/me/project。"
        }
      }
    }
  }
}
